{
	"enabledMcpjsonServers": ["bitrix24"],
	"env": {
		"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
		"CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-format.mjs\""
					}
				]
			}
		]
	}
}
