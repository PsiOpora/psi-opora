{
  "name": "@psi-opora/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./src/schemas/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "rm -rf .cache dist && tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@psi-opora/bitrix-client": "workspace:*",
    "@psi-opora/bot-core": "workspace:*",
    "@psi-opora/config": "workspace:*",
    "@psi-opora/db": "workspace:*",
    "@psi-opora/jobs": "workspace:*",
    "@psi-opora/tg-userbot": "workspace:*",
    "@psi-opora/unisender-client": "workspace:*",
    "@psi-opora/waha": "workspace:*",
    "@psi-opora/validators": "workspace:*",
    "@orpc/contract": "^1.14.12",
    "@orpc/server": "^1.14.12",
    "better-auth": "1.6.25",
    "superjson": "2.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@psi-opora/tsconfig": "workspace:*",
    "@types/node": "26.1.2",
    "typescript": "6.0.3"
  }
}
