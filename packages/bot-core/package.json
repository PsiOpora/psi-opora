{
  "name": "@psi-opora/bot-core",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "setup:bitrix": "bun run --env-file=../../.env scripts/setup-bitrix-connector.ts",
    "setup:bitrix-source": "bun run --env-file=../../.env scripts/setup-bitrix-source.ts",
    "list:bitrix-sources": "bun run --env-file=../../.env scripts/list-bitrix-sources.ts"
  },
  "dependencies": {
    "@psi-opora/config": "workspace:*",
    "@psi-opora/db": "workspace:*",
    "@upstash/redis": "^1.38.0",
    "grammy": "^1.44.0",
    "@grammyjs/conversations": "^2.1.1"
  },
  "devDependencies": {
    "tsdown": "^0.22.4"
  }
}
