{
  "name": "@psi-opora/bot-core",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./funnel-steps": {
      "types": "./dist/utils/funnel-steps.d.mts",
      "default": "./dist/utils/funnel-steps.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "setup:bitrix-source": "bun run --env-file=../../.env scripts/setup-bitrix-source.ts",
    "list:bitrix-sources": "bun run --env-file=../../.env scripts/list-bitrix-sources.ts",
    "backfill:crm-links": "bun run --env-file=../../.env scripts/backfill-crm-links.ts"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@psi-opora/config": "workspace:*",
    "@psi-opora/db": "workspace:*",
    "@psi-opora/emails": "workspace:*",
    "ai": "^7.0.93",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "tsdown": "^0.23.0"
  }
}
