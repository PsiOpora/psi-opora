{
	"name": "@psi-opora/telemetry",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"license": "MIT",
	"scripts": {
		"build": "rm -rf .cache dist && tsc",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"format": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"test": "bun test",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@opentelemetry/api": "1.10.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.300.0",
		"@opentelemetry/resources": "3.0.0",
		"@opentelemetry/sdk-trace": "3.0.0"
	},
	"devDependencies": {
		"@psi-opora/tsconfig": "workspace:*",
		"@types/bun": "1.4.4",
		"@types/node": "26.6.5",
		"typescript": "7.0.2"
	}
}
