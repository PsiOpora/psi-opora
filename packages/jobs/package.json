  },
  "devDependencies": {
    "@psi-opora/tsconfig": "workspace:*",
    "@trigger.dev/build": "4.5.7",
    "@types/node": "26.1.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.23.0",
    "tsdown": "^0.22.13",
