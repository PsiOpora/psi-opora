{
	"name": "@psi-opora/max-userbot",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsdown --watch",
		"manual-login": "bun run scripts/manual-login.ts",
		"manual-relay": "bun run scripts/manual-relay.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@msgpack/msgpack": "3.1.3",
		"@psi-opora/bot-core": "workspace:*",
		"@psi-opora/config": "workspace:*",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@psi-opora/tsconfig": "workspace:*",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.2",
		"tsdown": "^0.23.0",
		"typescript": "7.0.2"
	}
}
