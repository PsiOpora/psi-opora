{
  "name": "@psi-opora/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./client.ws": {
      "types": "./dist/client.ws.d.mts",
      "default": "./dist/client.ws.mjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.mts",
      "default": "./dist/schema/index.mjs"
    },
    "./queries": {
      "types": "./dist/queries/index.d.mts",
      "default": "./dist/queries/index.mjs"
    },
    "./queries.edge": {
      "types": "./dist/queries/index.edge.d.mts",
      "default": "./dist/queries/index.edge.mjs"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsdown",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "push": "bun --env-file=../../.env run drizzle-kit push",
    "studio": "bun --env-file=../../.env run drizzle-kit studio",
    "drop": "bun --env-file=../../.env run src/scripts/drop-schema.ts",
    "generate": "bun --env-file=../../.env run drizzle-kit generate",
    "migrate": "bun --env-file=../../.env run src/scripts/migrate.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@psi-opora/config": "workspace:*",
    "@vercel/postgres": "0.10.0",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "postgres": "^3.4.7",
    "ws": "^8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@psi-opora/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3"
  }
}
