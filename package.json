{
  "name": "psi-opora",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:tg": "turbo dev --filter=@psi-opora/tg-bot",
    "dev:max": "turbo dev --filter=@psi-opora/max-bot",
    "dev:dashboard": "turbo dev --filter=@psi-opora/dashboard",
    "dev:landing": "turbo dev --filter=@psi-opora/landing",
    "build": "turbo run build",
    "postinstall": "turbo run build",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.0",
    "turbo": "^2.10.2",
    "typescript": "^6.0.3"
  }
}
