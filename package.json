{
  "name": "tg-bot",
  "scripts": {
    "dev": "bun run --env-file=.env src/bot.ts",
    "build": "bun build src/bot.ts --target node --outfile dist/bot.js",
    "start": "tsx src/bot.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.44.0",
    "zod": "^4.4.3"
  }
}
