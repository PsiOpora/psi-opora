# ── Telegram Bot ─────────────────────────────────────────────
TG_BOT_TOKEN=your_telegram_bot_token
TG_WEBHOOK_URL=https://your-tg-app.vercel.app
# Уникальный ID этого бота — попадает в Bitrix (UTM_CONTENT) как "какой именно бот".
# Обязательно свой на каждый деплой, если ботов несколько.
TG_BOT_ID=main_tg_bot

TG_BITRIX_WEBHOOK_URL=https://your-bitrix.bitrix24.ru/rest/1/your_token/
TG_BITRIX_OPEN_LINE_ID=5
TG_BITRIX_CONNECTOR_ID=psiopora_tg_bot

# ── MAX Messenger Bot ─────────────────────────────────────────
MAX_BOT_TOKEN=your_max_bot_token
MAX_WEBHOOK_URL=https://your-max-app.vercel.app
MAX_BOT_ID=main_max_bot

MAX_BITRIX_WEBHOOK_URL=https://your-bitrix.bitrix24.ru/rest/1/your_token/
MAX_BITRIX_OPEN_LINE_ID=6
MAX_BITRIX_CONNECTOR_ID=psiopora_max_bot

# ── Upstash Redis (общий для обоих) ──────────────────────────
KV_REST_API_URL=https://your-redis.upstash.io
KV_REST_API_TOKEN=your_upstash_token
