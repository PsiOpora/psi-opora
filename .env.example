# ── Telegram Bot ─────────────────────────────────────────────
TG_BOT_TOKEN=your_telegram_bot_token
TG_WEBHOOK_URL=https://your-tg-app.vercel.app
# Уникальный ID этого бота — попадает в Bitrix (UTM_CONTENT) как "какой именно бот".
# Обязательно свой на каждый деплой, если ботов несколько.
TG_BOT_ID=main_tg_bot

TG_BITRIX_WEBHOOK_URL=https://your-bitrix.bitrix24.ru/rest/1/your_token/
TG_BITRIX_OPEN_LINE_ID=5
TG_BITRIX_CONNECTOR_ID=psiopora_tg_bot
# Источник (справочник CRM) для контактов/сделок из этого бота.
# Узнать код существующего источника: bun run list:bitrix-sources -- telegram
# Если источника ещё нет — создать: bun run setup:bitrix-source -- telegram
TG_BITRIX_SOURCE_ID=BOT_TELEGRAM
TG_BITRIX_SOURCE_NAME=Telegram-бот

# ── MAX Messenger Bot ─────────────────────────────────────────
MAX_BOT_TOKEN=your_max_bot_token
MAX_WEBHOOK_URL=https://your-max-app.vercel.app
MAX_BOT_ID=main_max_bot

MAX_BITRIX_WEBHOOK_URL=https://your-bitrix.bitrix24.ru/rest/1/your_token/
MAX_BITRIX_OPEN_LINE_ID=6
MAX_BITRIX_CONNECTOR_ID=psiopora_max_bot
# bun run list:bitrix-sources -- max
MAX_BITRIX_SOURCE_ID=BOT_MAX
MAX_BITRIX_SOURCE_NAME=MAX-бот

# ── Neon PostgreSQL (apps/dashboard) ─────────────────────────
# База данных для хранения рекламных credentials и статистики.
# Создать проект: https://neon.tech → New Project → PostgreSQL
POSTGRES_URL=postgresql://user:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Секрет для Vercel Cron (защита /api/ad-stats-sync от посторонних запросов)
CRON_SECRET=your_random_secret_string

# ── Trigger.dev (packages/jobs — фоновая отправка рассылок) ───
# Создать проект: https://cloud.trigger.dev → New Project.
# Secret key: Project → API keys. Project ref: Project → Settings.
# Personal Access Token: Profile → Personal Access Tokens, нужен для деплоя через CLI и в GitHub Actions.
# Локальный запуск воркера: cd packages/jobs && bun run dev:trigger
TRIGGER_SECRET_KEY=tr_dev_your_secret_key
TRIGGER_PROJECT_REF=proj_your_project_ref
TRIGGER_ACCESS_TOKEN=tr_pat_your_personal_access_token

# ── Upstash Redis (общий для всех приложений) ────────────────
KV_REST_API_URL=https://your-redis.upstash.io
KV_REST_API_TOKEN=your_upstash_token

# ── Bitrix24 Webhook App (apps/bitrix-webhook) ─────────────────
# Секретный токен для верификации исходящего вебхука от Bitrix24.
# Задаётся при создании исходящего вебхука в настройках открытой линии.
# В самом вебхуке (Разработчикам → Другое → Исходящий вебхук) нужно отметить
# и событие "OnImConnectorMessageAdd" — иначе ответы оператора не будут
# долетать до клиента в Telegram/MAX (см. sendMessageToOpenLine).
BITRIX_WEBHOOK_TOKEN=your_bitrix_webhook_secret_token
# Секретный токен для верификации исходящего вебхука от Bitrix24
# при обновлении CRM-сделки (ONCRMDEALUPDATE).
BITRIX_CRM_WEBHOOK_TOKEN=your_bitrix_crm_webhook_secret_token

# ── Dashboard (Bitrix24 Local App — CRM/маркетинг аналитика) ──
# Разработчикам → Другое → Локальное приложение в вашем портале Bitrix24.
# Путь для первоначальной установки и путь для приложения — оба указывают
# на корень задеплоенного apps/dashboard (см. apps/dashboard/README.md).
DASHBOARD_BITRIX_CLIENT_ID=local.xxxxxxxxxxxxxx.xxxxxxxx
DASHBOARD_BITRIX_CLIENT_SECRET=your_client_secret
# Только для локальной разработки (bun run dev:dashboard) вне портала —
# входящий вебхук, чтобы видеть реальные данные CRM без OAuth-инсталляции.
DASHBOARD_BITRIX_WEBHOOK_URL=https://your-bitrix.bitrix24.ru/rest/1/your_token/

# ── Telegram userbot (личный номер как отдельная Open Line, packages/tg-userbot) ──
# api_id/api_hash своего приложения — https://my.telegram.org/apps
TG_USERBOT_API_ID=1234567
TG_USERBOT_API_HASH=your_telegram_api_hash
# Ключ шифрования MTProto-сессий в БД (32 байта base64): openssl rand -base64 32
TG_USERBOT_ENCRYPTION_KEY=your_base64_32_byte_key
# ID коннектора Открытых линий для этого канала (imconnector.register).
TG_USERBOT_CONNECTOR_ID=psiopora_tg_personal

# ── Yandex Direct API (apps/dashboard — рекламная аналитика) ──
# Создать приложение: https://oauth.yandex.ru/client/new
# Права: Яндекс.Директ (direct:read)
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
# Получить refresh_token: https://oauth.yandex.ru/authorize?response_type=code&client_id=YOUR_CLIENT_ID
YANDEX_REFRESH_TOKEN=your_yandex_refresh_token

# ── VK Ads API (apps/dashboard — рекламная аналитика) ─────────
# Создать приложение: https://vk.com/apps?act=manage
# Права: ads
VK_ACCESS_TOKEN=your_vk_access_token
# ID рекламного кабинета — https://vk.com/ads?act=office
VK_ADS_ACCOUNT_ID=your_vk_account_id

# ── Бэкап CRM в Yandex Object Storage (apps/dashboard) ─────────
# Настраивается через UI: /settings/backup (хранится в БД, эти переменные
# не обязательны). CRON_SECRET выше также защищает /api/crm-backup.
# Бакет и статический ключ: https://console.yandex.cloud/ → Object Storage.
#
# Для локальной разработки в docker-compose поднимается MinIO
# (S3-совместимое хранилище) — запустить: docker compose up minio minio-init
# Затем в /settings/backup указать:
#   Endpoint: http://localhost:9000
#   Регион:   us-east-1
#   Бакет:    crm-backups (создаётся автоматически контейнером minio-init)
#   Access Key / Secret Key: значения MINIO_ROOT_USER / MINIO_ROOT_PASSWORD ниже
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BACKUP_BUCKET=crm-backups

# ── Email-рассылка через Unisender (apps/dashboard — /email-broadcast) ────
# Настраивается через UI: /settings/email (хранится в БД, как и настройки
# бэкапа выше) — env-переменные здесь не нужны. API-ключ — в личном
# кабинете Unisender: Настройки → API-ключи. Адрес отправителя должен быть
# подтверждён в Unisender (SPF/DKIM), иначе письма будут попадать в спам.
