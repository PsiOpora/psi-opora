# ── Telegram Bot ─────────────────────────────────────────────
# Токен бота (@BotFather) НЕ задаётся здесь — администратор вводит его
# в UI при подключении канала в Открытых линиях (хранится зашифрованным
# в bot_connectors.bot_token_encrypted, см. packages/api/src/routers/bot-connector).
# Полный адрес обработчика вебхука (с путём /api/webhook) — setMessengerWebhook
# (packages/jobs/src/messenger.ts) использует значение как есть, путь сам не достраивает.
TG_WEBHOOK_URL=https://your-tg-app.vercel.app/api/webhook
# Уникальный ID этого бота — попадает в Bitrix (UTM_CONTENT) как "какой именно бот".
# Обязательно свой на каждый деплой, если ботов несколько.
TG_BOT_ID=main_tg_bot

TG_BITRIX_WEBHOOK_URL=https://your-bitrix.bitrix24.ru/rest/1/your_token/
# Коннектор/линия Открытой линии для этого бота НЕ задаются здесь — коннектор
# регистрируется кнопкой в дашборде (/settings/bot), а привязка к линии и
# вебхук настраиваются автоматически, когда администратор добавляет канал на
# линии в Контакт-центре (см. README, раздел «Официальные боты»).
# Источник (справочник CRM) для контактов/сделок из этого бота.
# Узнать код существующего источника: bun run list:bitrix-sources -- telegram
# Если источника ещё нет — создать: bun run setup:bitrix-source -- telegram
TG_BITRIX_SOURCE_ID=BOT_TELEGRAM
TG_BITRIX_SOURCE_NAME=Telegram-бот

# ── MAX Messenger Bot ─────────────────────────────────────────
# Токен бота НЕ задаётся здесь — вводится в UI так же, как для Telegram выше.
# Полный адрес обработчика вебхука (с путём /api/webhook) — см. комментарий у TG_WEBHOOK_URL.
MAX_WEBHOOK_URL=https://your-max-app.vercel.app/api/webhook
MAX_BOT_ID=main_max_bot

MAX_BITRIX_WEBHOOK_URL=https://your-bitrix.bitrix24.ru/rest/1/your_token/
# Коннектор/линия — см. комментарий у TG_BITRIX_WEBHOOK_URL выше, для MAX всё то же самое.
# bun run list:bitrix-sources -- max
MAX_BITRIX_SOURCE_ID=BOT_MAX
MAX_BITRIX_SOURCE_NAME=MAX-бот

# ── PostgreSQL ────────────────────────────────────────────────
# Внутри k3s приложения используют ClusterIP (TLS на одной ноде не нужен):
POSTGRES_URL=postgresql://psi_opora:password@postgres:5432/psi_opora?sslmode=disable
# Снаружи: postgresql://psi_opora:password@SERVER_IP:30432/psi_opora?sslmode=verify-full
# и публичный сертификат k3s/postgres-ca.crt как root certificate.

# Секрет для Vercel Cron (защита /api/ad-stats-sync от посторонних запросов)
CRON_SECRET=your_random_secret_string

# ── Hatchet (packages/jobs — фоновые и периодические задачи) ──
# Сейчас используется Hatchet Cloud: Settings → API Tokens → Generate API Token.
# Адреса Cloud уже зашиты в токен, HOST_PORT/API_URL/TLS_STRATEGY не задаются.
HATCHET_CLIENT_TOKEN=eyJhbGciOi...
# Локальный worker запускается тем же токеном:
# cd packages/jobs && bun run dev
#
# Для будущего self-hosted Hatchet в k3s раскомментируйте:
# HATCHET_CLIENT_HOST_PORT=hatchet-stack-engine:7070
# HATCHET_CLIENT_API_URL=http://hatchet-stack-api:8080
# HATCHET_CLIENT_TLS_STRATEGY=none

# ── Redis (общий для всех приложений) ──────────────────────
# Локально удобнее единый URL. В k3s REDIS_HOST/REDIS_PORT и
# REDIS_PASSWORD передаются раздельно.
REDIS_URL=redis://:your_password@localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_password

# ── Bitrix24 Webhook App (apps/bitrix-webhook) ─────────────────
# Секретный токен(ы) для верификации исходящего вебхука от Bitrix24 — можно
# перечислить несколько через запятую. Основной сценарий — токен приложения
# дашборда, который приходит автоматически: при регистрации коннектора
# дашборд сам подписывается на нужные события (event.bind, см.
# apps/dashboard/src/lib/bitrix/connector-events.ts), Bitrix присылает
# события с собственным application_token приложения — возьмите его из
# первого же лога apps/bitrix-webhook ("неверный токен: получено=...") и
# впишите сюда. Второй вариант (без дашборда) — вручную создать исходящий
# вебхук в настройках портала (Разработчикам → Другое → Исходящий вебхук),
# отметив события "OnImConnectorMessageAdd" (иначе ответы оператора не будут
# долетать до клиента в Telegram/MAX, см. sendMessageToOpenLine),
# "OnImConnectorStatusDelete" и "OnImConnectorLineDelete" (иначе запись в
# bot_connectors не подчистится сама при отключении канала прямо в Bitrix).
BITRIX_WEBHOOK_TOKEN=your_bitrix_webhook_secret_token
# Полный адрес обработчика вебхука этого же apps/bitrix-webhook (с путём
# /api/bitrix-webhook) — дашборд обращается к нему из браузера
# (b24.actions.v2.call.make("event.bind", ...)), чтобы подписаться на события
# коннектора сразу при регистрации, без ручной настройки выше.
# subscribeConnectorEvents (apps/dashboard/src/lib/bitrix/connector-events.ts)
# использует значение как есть, путь сам не достраивает — без него Bitrix
# будет слать события на корень apps/bitrix-webhook (404, нет POST-роута)
# и ответы оператора не будут доходить до клиента.
NEXT_PUBLIC_BITRIX_WEBHOOK_APP_URL=https://your-bitrix-webhook.vercel.app/api/bitrix-webhook
# Секретный токен для верификации исходящего вебхука от Bitrix24
# при обновлении CRM-сделки (ONCRMDEALUPDATE).
BITRIX_CRM_WEBHOOK_TOKEN=your_bitrix_crm_webhook_secret_token

# ── Dashboard (Bitrix24 Local App — CRM/маркетинг аналитика) ──
# Разработчикам → Другое → Локальное приложение в вашем портале Bitrix24.
# Путь для первоначальной установки и путь для приложения — оба указывают
# на корень задеплоенного apps/dashboard (см. apps/dashboard/README.md).
DASHBOARD_BITRIX_CLIENT_ID=local.xxxxxxxxxxxxxx.xxxxxxxx
DASHBOARD_BITRIX_CLIENT_SECRET=your_client_secret
# Только для локальной разработки (bun run dev:dashboard) вне портала —
# входящий вебхук, чтобы видеть реальные данные CRM без OAuth-инсталляции.
DASHBOARD_BITRIX_WEBHOOK_URL=https://your-bitrix.bitrix24.ru/rest/1/your_token/
# memberId портала, куда задеплоены apps/tg-bot и apps/max-bot — нужен, чтобы
# дублировать переписку в Открытые линии через OAuth-приложение дашборда
# (imconnector.* требуют именно app context, обычный вебхук не подходит).
# Установите приложение дашборда на портал, откройте его — memberId
# отобразится в настройках рядом с карточкой «Вкладка Мессенджер».
BITRIX_MEMBER_ID=
# Необязательно: публичный обработчик OnCrmDealUpdate
BITRIX_CRM_DEAL_UPDATE_HANDLER_URL=https://psi-opora-bitrix-webhook.orixon.ru/api/consultation-reminder-deal-update
# ID Андрея Клюева в Bitrix24 (владелец календарных событий диагностики)
BITRIX_DIAGNOSTIC_USER_ID=1
# Необязательно: переопределяет https://psi-opora.ru/prices/
# Также приоритет имеет поле сделки «Ссылка на оплату», если оно заполнено.
DIAGNOSTIC_PAYMENT_URL=

# ── Clients (Bitrix24 Local App — своя регистрация приложения) ──
# Отдельные client_id/client_secret для apps/clients, независимые от
# DASHBOARD_BITRIX_CLIENT_ID/SECRET, даже если ставится на тот же портал.
CLIENTS_BITRIX_CLIENT_ID=local.xxxxxxxxxxxxxx.xxxxxxxx
CLIENTS_BITRIX_CLIENT_SECRET=your_client_secret

# ── Telegram userbot (личный номер как отдельная Open Line, packages/tg-userbot) ──
# api_id/api_hash приложения Telegram НЕ здесь — их вводит сам администратор
# в настройках коннектора внутри Битрикс24 (my.telegram.org/apps), отдельно
# для каждого подключаемого номера, и они хранятся в БД (api_hash — шифрованно).
# Ключ шифрования MTProto-сессий и api_hash в БД (32 байта base64): openssl rand -base64 32
TG_USERBOT_ENCRYPTION_KEY=your_base64_32_byte_key
# ID коннектора Открытых линий для этого канала (imconnector.register).
TG_USERBOT_CONNECTOR_ID=psiopora_tg_personal

# ── WhatsApp userbot (личный номер через WAHA, packages/waha) ──
# Контейнер WAHA поднимается на том же сервере, что и tg-userbot-worker:
#   docker compose up -d waha
# WAHA_URL — публичный адрес контейнера (нужен и Vercel-приложениям:
# oRPC-роутеры дашборда и apps/bitrix-webhook ходят в него по REST).
WAHA_URL=https://your-server:3050
# Ключ API WAHA (заголовок X-Api-Key) — придумайте случайную строку,
# она же передаётся контейнеру в docker-compose: openssl rand -hex 32
WAHA_API_KEY=your_waha_api_key
# Публичный адрес роута входящих сообщений (apps/bitrix-webhook) — WAHA
# доставляет туда события `message` подключённых номеров.
WAHA_WEBHOOK_URL=https://your-bitrix-webhook.vercel.app/api/waha-webhook
# HMAC-ключ подписи вебхука (проверяется в api/waha-webhook): openssl rand -hex 32
WAHA_WEBHOOK_SECRET=your_waha_webhook_secret
# ID коннектора Открытых линий для этого канала (imconnector.register).
WA_PERSONAL_CONNECTOR_ID=psiopora_wa_personal

# ── Yandex Direct API (apps/dashboard — рекламная аналитика) ──
# Создать приложение: https://oauth.yandex.ru/client/new
# Права: Яндекс.Директ (direct:read)
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
# Получить refresh_token: https://oauth.yandex.ru/authorize?response_type=code&client_id=YOUR_CLIENT_ID
YANDEX_REFRESH_TOKEN=your_yandex_refresh_token

# ── VK Ads API (apps/dashboard — рекламная аналитика) ─────────
# Создать приложение: https://vk.com/apps?act=manage
# Права: ads
VK_ACCESS_TOKEN=your_vk_access_token
# ID рекламного кабинета — https://vk.com/ads?act=office
VK_ADS_ACCOUNT_ID=your_vk_account_id

# ── Бэкап CRM в Yandex Object Storage (apps/dashboard) ─────────
# Настраивается через UI: /settings/backup (хранится в БД, эти переменные
# не обязательны). CRON_SECRET выше также защищает /api/crm-backup.
# Бакет и статический ключ: https://console.yandex.cloud/ → Object Storage.
#
# Для локальной разработки в docker-compose поднимается MinIO
# (S3-совместимое хранилище) — запустить: docker compose up minio minio-init
# Затем в /settings/backup указать:
#   Endpoint: http://localhost:9000
#   Регион:   us-east-1
#   Бакет:    crm-backups (создаётся автоматически контейнером minio-init)
#   Access Key / Secret Key: значения MINIO_ROOT_USER / MINIO_ROOT_PASSWORD ниже
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BACKUP_BUCKET=crm-backups

# ── OpenRouter (LLM-подстраховка на шаге «имя» в боте) ─────────
# Если на вопрос «Как вас зовут?» клиент присылает сразу имя+телефон+email
# одним сообщением (например, копипастом из визитки/анкеты), LLM пытается
# разложить это на поля вместо того, чтобы записать всё как имя. Без ключа
# шаг работает как раньше — весь текст сохраняется как имя.
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ── Email-рассылка через Unisender (apps/dashboard — /email-broadcast) ────
# Настраивается через UI: /settings/email (хранится в БД, как и настройки
# бэкапа выше) — env-переменные здесь не нужны. API-ключ — в личном
# кабинете Unisender: Настройки → API-ключи. Адрес отправителя должен быть
# подтверждён в Unisender (SPF/DKIM), иначе письма будут попадать в спам.
